# Auto detect text files and perform LF normalization
* text=auto

# Hidden
.*                  export-ignore

# Directories
/docs               export-ignore
/tests              export-ignore
/build              export-ignore

# Files
phpunit.xml*        export-ignore
composer.json       export-ignore
composer.lock       export-ignore
package.json        export-ignore
package-lock.json   export-ignore
